[
  {
    "type": "function",
    "function": {
      "name": "semagraph_anchor_state64",
      "description": "Deterministically anchor exactly six observed or known parameters into a State64 six-bit state. This tool must not infer missing observations.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": ["observations"],
        "properties": {
          "observations": {
            "type": "array",
            "minItems": 6,
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "value", "operator", "threshold"],
              "properties": {
                "key": { "type": "string" },
                "value": { "oneOf": [{ "type": "number" }, { "type": "boolean" }, { "type": "string" }] },
                "operator": { "type": "string", "enum": ["eq", "neq", "gt", "gte", "lt", "lte"] },
                "threshold": { "oneOf": [{ "type": "number" }, { "type": "boolean" }, { "type": "string" }] },
                "trueBit": { "type": "integer", "enum": [0, 1] },
                "falseBit": { "type": "integer", "enum": [0, 1] },
                "unit": { "type": "string" },
                "source": { "type": "string" }
              }
            }
          }
        }
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "semagraph_lookup_transition64",
      "description": "Look up deterministic State64 transition metadata for a source and target state.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceStateId", "targetStateId"],
        "properties": {
          "sourceStateId": { "type": "string", "pattern": "^S64-[01]{6}$" },
          "targetStateId": { "type": "string", "pattern": "^S64-[01]{6}$" }
        }
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "semagraph_compress_chain64",
      "description": "Compress an ordered chain of State64 states into mutation masks, net mutation and deterministic transition signature.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": ["states"],
        "properties": {
          "states": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string", "pattern": "^S64-[01]{6}$" }
          }
        }
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "semagraph_policy_context64",
      "description": "Build a policy-synthesis context from a deterministic State64 transition chain. The LLM may write policy but must not alter observed states or signatures.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": ["states"],
        "properties": {
          "states": { "type": "array", "minItems": 2, "items": { "type": "string", "pattern": "^S64-[01]{6}$" } },
          "objective": { "type": "string" },
          "constraints": { "type": "array", "items": { "type": "string" } },
          "evidenceRefs": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "semagraph_validate_math_anchor",
      "description": "Structurally validate a candidate mathematical domain and anchor contract. Validation is deterministic but does not register the candidate or make it authoritative.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain", "anchor"],
        "properties": {
          "domain": { "type": "object" },
          "anchor": { "type": "object" }
        }
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "semagraph_formalize_observations",
      "description": "Apply one explicitly selected, previously registered mathematical anchor version to supplied evidence. It never chooses an anchor or fills missing observations.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": ["registryBundle", "anchorDefinitionId", "anchorVersion", "observations"],
        "properties": {
          "registryBundle": { "$ref": "#/$defs/registryBundle" },
          "anchorDefinitionId": { "type": "string", "minLength": 1 },
          "anchorVersion": { "type": "string", "minLength": 1 },
          "observations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "value", "evidenceReferences"],
              "properties": {
                "key": { "type": "string", "minLength": 1 },
                "value": { "type": ["boolean", "number", "string"] },
                "unit": { "type": "string" },
                "evidenceReferences": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "source"],
                    "properties": {
                      "id": { "type": "string", "minLength": 1 },
                      "source": { "type": "string", "minLength": 1 },
                      "uri": { "type": "string" },
                      "observedAt": { "type": "string" },
                      "contentHash": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        },
        "$defs": {
          "registryBundle": {
            "type": "object",
            "additionalProperties": false,
            "required": ["domains", "registeredAnchors"],
            "properties": {
              "domains": { "type": "array", "items": { "type": "object" } },
              "registeredAnchors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["authority", "acceptedBy", "definition"],
                  "properties": {
                    "authority": { "const": "registered" },
                    "acceptedBy": { "type": "string", "minLength": 1 },
                    "definition": { "type": "object" }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "semagraph_anchor_formalized_state64",
      "description": "Project a replay-key-verified formalized snapshot through its exact registered projection version into canonical State64, with per-bit lineage.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": ["registryBundle", "formalizedSnapshot"],
        "properties": {
          "registryBundle": {
            "type": "object",
            "required": ["domains", "registeredAnchors"],
            "properties": {
              "domains": { "type": "array", "items": { "type": "object" } },
              "registeredAnchors": { "type": "array", "items": { "type": "object" } }
            }
          },
          "formalizedSnapshot": {
            "type": "object",
            "required": ["mathematicalDomainId", "mathematicalDomainVersion", "anchorDefinitionId", "anchorVersion", "projectionVersion", "formalVariables", "formalizedObservations", "assumptions", "validityScope", "replayKey"]
          }
        }
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "semagraph_inspect_anchor_trace",
      "description": "Return the deterministic predicate, formal-variable/relation, observation-binding and evidence lineage for one State64 bit.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trace", "position"],
        "properties": {
          "trace": { "type": "object", "required": ["stateId", "bits", "replayKey"] },
          "position": { "type": "integer", "minimum": 1, "maximum": 6 }
        }
      }
    }
  }
]
