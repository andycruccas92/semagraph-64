{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semagraph.org/schemas/mathematical-domain-definition.schema.json",
  "title": "Mathematical Domain Definition",
  "description": "A declared operational mathematical structure for an admissible observational domain; it is not an ontological truth claim.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "label", "observationalSpace", "structure"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "observationalSpace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "admissibleObservationKeys"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "admissibleObservationKeys": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "family", "description", "declaredAxioms"],
      "properties": {
        "kind": { "enum": ["metric", "pseudometric", "norm", "vector_space_relation", "partial_order", "total_order", "ranking_relation", "node", "edge", "directed_relation", "path", "connectivity", "dependency_graph", "probability_distribution", "conditional_probability", "entropy", "divergence", "mutual_information_relation", "state_space", "transition_relation", "discrete_dynamical_system", "feasibility_relation", "constraint_set", "boundary", "admissible_region", "utility", "cost", "objective", "preference_relation", "similarity_function", "kernel_relation", "equivalence_relation", "probability_uncertainty", "interval_uncertainty", "bounded_uncertainty"] },
        "family": { "enum": ["metric_geometric", "order", "graph", "probability_information", "dynamical_state", "constraint", "decision_value", "similarity", "uncertainty"] },
        "description": { "type": "string", "minLength": 1 },
        "declaredAxioms": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
