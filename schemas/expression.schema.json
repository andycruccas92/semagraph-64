{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semagraph.org/schemas/expression.schema.json",
  "title": "SemaGraph Visual Expression",
  "type": "object",
  "required": ["kind"],
  "oneOf": [
    {
      "properties": {
        "kind": { "const": "state64" },
        "stateId": { "type": "string", "pattern": "^S64-[01]{6}$" },
        "movingLines": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 6 },
          "uniqueItems": true
        }
      },
      "required": ["kind", "stateId"],
      "additionalProperties": false
    },
    {
      "properties": {
        "kind": { "const": "relation" },
        "relation": {
          "type": "string",
          "enum": ["transforms_to", "similar_to", "opposes", "contains", "amplifies", "releases", "blocks"]
        },
        "from": { "$ref": "#" },
        "to": { "$ref": "#" }
      },
      "required": ["kind", "relation", "from", "to"],
      "additionalProperties": false
    }
  ]
}
