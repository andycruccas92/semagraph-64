{
  "name": "@semagraph/kernel",
  "version": "0.7.0",
  "description": "Domain-neutral parametric state-transition kernel for SemaGraph. Deterministic, dependency-free classifier and compressor for state-transition trajectories.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Andy Cruccas",
  "homepage": "https://github.com/andycruccas92/semagraph-64#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andycruccas92/semagraph-64.git",
    "directory": "packages/kernel"
  },
  "bugs": {
    "url": "https://github.com/andycruccas92/semagraph-64/issues"
  },
  "keywords": [
    "state-machine",
    "state-transition",
    "trajectory",
    "deterministic",
    "compression",
    "regime-classification",
    "kernel"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
