{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semagraph.org/schemas/state64-expression.schema.json",
  "title": "SemaGraph State64 Adapter Expression",
  "description": "Optional six-bit visual adapter expression. It is not the domain-neutral kernel schema.",
  "type": "object",
  "required": ["kind"],
  "oneOf": [
    {
      "properties": {
        "kind": { "const": "state64" },
        "stateId": { "type": "string", "pattern": "^S64-[01]{6}$" },
        "mutationMask": { "type": "string", "pattern": "^M64-[01]{6}$" },
        "movingLines": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 6 }, "uniqueItems": true }
      },
      "required": ["kind", "stateId"],
      "additionalProperties": false
    },
    {
      "properties": {
        "kind": { "const": "relation" },
        "relation": { "type": "string", "enum": ["transforms_to", "similar_to", "opposes", "contains"] },
        "from": { "$ref": "#" },
        "to": { "$ref": "#" }
      },
      "required": ["kind", "relation", "from", "to"],
      "additionalProperties": false
    }
  ]
}
